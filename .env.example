# Copy to .env and fill in real values. Never commit .env itself.

# --- DeepSeek (agent brain / TextPlanningProvider reasoning model) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Zhipu GLM (vision analysis candidate; also has image gen + web search tool) ---
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- Aliyun DashScope / Qwen (vision analysis + image generation candidate) ---
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_DASHSCOPE_HOST=
ALIYUN_DASHSCOPE_OPENAI_BASE_URL=
ALIYUN_DASHSCOPE_NATIVE_BASE_URL=

# --- Volcengine (即梦AI: img2img + clothing swap candidate) ---
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# --- Tencent Hunyuan (LLM + vision + clothing-swap candidate) ---
TENCENT_HUNYUAN_API_KEY=
TENCENT_HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# --- StepFun 阶跃星辰 (img2img 备选：0.5-2s / ¥0.02，缓解火山并发=1 的吞吐天花板) ---
# 注册地址 https://platform.stepfun.com/
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1

# --- Aliyun OSS (object storage) ---
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=

# --- Aliyun Content Moderation (内容安全) ---
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=

# --- Database / Queue ---
DATABASE_URL=
REDIS_URL=

# --- Weather (Open-Meteo development defaults) ---
# Public endpoints are intended for development/evaluation. Configure a
# licensed commercial or self-hosted HTTPS origin before production traffic.
WEATHER_GEOCODING_ORIGIN=https://geocoding-api.open-meteo.com
WEATHER_ARCHIVE_ORIGIN=https://archive-api.open-meteo.com
WEATHER_FORECAST_ORIGIN=https://api.open-meteo.com
WEATHER_API_KEY=
WEATHER_HISTORY_DIR=./data/weather-history
WEATHER_HISTORY_REFRESH_HOURS=168
WEATHER_FORECAST_DAYS=7
WEATHER_REQUEST_TIMEOUT_MS=8000
WEATHER_MAX_RESPONSE_BYTES=2097152
