# 密钥 —— 绝不入库。本仓库独立于上级 workspace，父目录的 .gitignore 规则不会继承过来，
# 所以这几行必须在这里重申一遍。
.env
.env.*
!.env.example

# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/

# Prisma 生成产物：由 schema 派生，`prisma generate` 可重建。
# Prisma 7 要求生成物落在源码树内（见 prisma/schema.prisma 注释），所以路径在 src 下，
# 但它仍然是产物而非源码。
src/generated/

# 运行时状态
# ⚠ gitignore **不支持行尾注释**：`data/    # 说明` 会把整行（含空格和 #）当成模式，
# 于是 data/ 根本不被忽略。注释必须独占一行。这个坑本仓库初始化时踩过。
# 文件版 taskLedger（生产用 Postgres 版，见 lib/prismaTaskLedger.ts）
/data/
/.codegraph/
# 单实例推进锁
.agent-lock.json
tmp-uploads/
*.log

# 系统与编辑器
.DS_Store
.vscode/
.idea/

# ── 出图校准/基准产物与人脸样本：不入库 ──────────────────────────────────
# 发型渲染校准产出（本地图片）
calibration-out/
# 切换 provider 前的旧校准图备份，命名形如 calibration-out.seededit-legacy-<日期>
calibration-out.*/
# provider 质感对照台产出（npm run bench:image）
bench-out/

# 发型矩阵等基准资产（760M）。可由脚本重新生成，且体积远超 git 的合理承载；
# ⚠ 分发方案（OSS / LFS）尚未确定，clone 后需从现有环境拷贝。
benchmark-assets/

# 校准/联调用的真人照片。**含开发者本人照片**——隐私敏感，绝不入库。
# 校准台通过 --photo 显式传路径，不依赖固定文件名。
*.tmp.jpg
*.tmp.jpeg
*.tmp.png
real-face.*
